    "# Get position of the robot to initialize EKF\n",
    "ret, frame = cam.get_frame()\n",
    "\n",
    "detected, pose, _ = vision.localize_robot(frame, is_world_frame=False)\n",
    "print(f\"Robot detected: {detected}, pose: {pose}\")\n",
    "\n",
    "detected_goal, goal_pos = vision.get_goal_position(frame, is_world_frame=False)\n",
    "print(f\"Goal detected: {detected_goal}, position: {goal_pos}\")\n",
    "\n",
    "# Initialize navigation\n",
    "# obsctacle = 255\n",
    "# free_space = 0\n",
    "nav.set_map(grid)\n",
    "\n",
    "path, explored, exporation_count = nav.grid_search_astar(Map=grid, S=pose, G=goal_pos)\n",
    "smooth_path = nav.grid_path_smoothing(path=path, Map=grid)\n",
    "closest_point = nav.find_closest_point_smoothed_path(pose, smooth_path)\n",
    "if closest_point is None:\n",
    "    print(\"No closest point found on path.\")\n",
    "    nav.display_map(Map=grid, \n",
    "                    path8=path, \n",
    "                    SearchStart=pose, \n",
    "                    SearchGoal=goal_pos, \n",
    "                    explored8=explored, \n",
    "                    smoothed_path=smooth_path, \n",
    "                    robot_pose=pose)\n",
    "else:\n",
    "    target_x_y, closest_seg_angle, target_seg_angle = nav.target_point(closest_point_on_path=closest_point,\n",
    "                                                                                look_ahead_distance=30,\n",
    "                                                                                path=smooth_path,\n",
    "                                                                                return_angles=True)\n",
    "    print(grid.shape)\n",
    "    nav.display_map(Map=grid, \n",
    "                    path8=path, \n",
    "                    SearchStart=pose, \n",
    "                    SearchGoal=goal_pos, \n",
    "                    explored8=explored, \n",
    "                    smoothed_path=smooth_path, \n",
    "                    robot_pose=pose, \n",
    "                    closest_point=closest_point,\n",
    "                    target_point=target_x_y)\n",
    "\n",
    "    px_per_cm = vision.pixels_per_cm\n",
    "\n",
    "    MAP_HEIGHT_MM = 600\n",
    "    THYMIO_TO_MM_SEC_LEFT = 100 / 35.1\n",
    "    THYMIO_TO_MM_SEC_RIGHT = 100 / 35.1\n",
    "    px_per_mm = px_per_cm / 10\n",
    "\n",
    "    tf = CoordinateTransform2D(px_per_mm, MAP_HEIGHT_MM)\n",
    "    speed_t = WheelSpeedTransform(THYMIO_TO_MM_SEC_LEFT, THYMIO_TO_MM_SEC_RIGHT)\n",
    "\n",
    "    pose_ekf = tf.vision_to_ekf(pose)\n",
    "\n",
    "    ekf.init_state(pose_ekf)\n",
    "\n",
    "    print(\"Ekf initial pose: \", ekf.x)"
