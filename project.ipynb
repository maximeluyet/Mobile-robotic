   "source": [
    "# Create a window for drawing and start Thymio Client\n",
    "cv2.namedWindow(\"output\", cv2.WINDOW_NORMAL)\n",
    "thymio = ThymioClient()\n",
    "\n",
    "cv2.imshow(\"output\", frame)\n",
    "\n",
    "# Hold window until user presses 's' to allow resizing\n",
    "while True:\n",
    "    if cv2.waitKey(1) & 0xFF == ord(''):\n",
    "        break\n",
    "\n",
    "KIDNAP_THRESH = 200   # Keep at 70 and lift high if black should be ignored\n",
    "D_T = 0.1\n",
    "TIMEOUT_CYCLES = 30\n",
    "\n",
    "# Robot State variables\n",
    "PLAN_PATH = True\n",
    "TIMEOUT = False\n",
    "\n",
    "timeout_count = 0\n",
    "\n",
    "### Main loop: run until goal is reached\n",
    "while True:\n",
    "\n",
    "    loop_start = time.time()\n",
    "\n",
    "    # Get a new camera frame:\n",
    "    ret, frame = cam.get_frame()\n",
    "\n",
    "    if not ret:\n",
    "        print(\"Error: could not read camera frame\")\n",
    "        continue # maybe break\n",
    "\n",
    "    # Plan a path if necessary:\n",
    "    if PLAN_PATH:\n",
    "        print(\"Plan new path\")\n",
    "        got_loc, pose, _ = vision.localize_robot(frame)\n",
    "        got_goal, goal_pos = vision.get_goal_position(frame)\n",
    "\n",
    "        if not got_loc:\n",
    "            print(\"Error: could not localize robot during planning\")\n",
    "            continue # maybe break\n",
    "        if not got_goal:\n",
    "            print(\"Error: could not localize goal during planning\")\n",
    "            continue  # maybe break\n",
    "\n",
    "        # Plan and smooth the path\n",
    "        path, explored, exporation_count = nav.grid_search_astar(Map=grid, S=pose, G=goal_pos)\n",
    "        smooth_path = nav.grid_path_smoothing(path=path, Map=grid)\n",
    "        closest_point = nav.find_closest_point_smoothed_path(pose, smooth_path)\n",
    "\n",
    "        if closest_point is None:\n",
    "            print(\"Error: no closest point found on path\")\n",
    "            # Display map in case of error\n",
    "            nav.display_map(Map=grid, path8=path, SearchStart=pose, SearchGoal=goal_pos, \n",
    "                            explored8=explored, smoothed_path=smooth_path, robot_pose=pose) # TODO: put some of these in class\n",
    "            break\n",
    "\n",
    "        # Get target point\n",
    "        ret = nav.target_point(closest_point_on_path=closest_point, look_ahead_distance=30,\n",
    "                               path=smooth_path, return_angles=True)\n",
    "        \n",
    "        target_x_y, closest_seg_angle, target_seg_angle = ret\n",
    "\n",
    "        # Map visualization removed here since plt.show() blocks -> lag\n",
    "        # nav.display_map(Map=grid, path8=path, SearchStart=pose, SearchGoal=goal_pos, explored8=explored, \n",
    "        #                 smoothed_path=smooth_path, robot_pose=pose, closest_point=closest_point,\n",
    "        #                 target_point=target_x_y) # TODO: put some of these in class\n",
    "\n",
    "        # Initialize EKF at robot position\n",
    "        pose_ekf = tf.vision_to_ekf(pose)\n",
    "        ekf.init_state(pose_ekf)\n",
    "\n",
    "        print(\"Path planned successfully\")\n",
    "        PLAN_PATH = False\n",
    "\n",
    "    # Get robot sensors:\n",
    "    prox, v_l, v_r, ground = thymio.get_measurements()\n",
    "\n",
    "    # Detect Kidnaping:\n",
    "    if ground[0] < KIDNAP_THRESH and ground[1] < KIDNAP_THRESH and not TIMEOUT:\n",
    "        # TODO: maybe here wait one tour and measure again if we have false positives\n",
    "        # -> worked well til now\n",
    "\n",
    "        print(\"Robot got kidnaped\")\n",
    "        thymio.set_motors(0, 0)\n",
    "        \n",
    "        TIMEOUT = True\n",
    "\n",
    "    # Drive to target if not in timeout:\n",
    "    if not TIMEOUT:\n",
    "\n",
    "        # EKF predict step + visualization:\n",
    "        v_l_ekf, v_r_ekf = speed_t.thymio_to_mmsec(v_l, v_r)\n",
    "        # TODO: maybe here keep track of the real D_T to be more precise\n",
    "        ekf.predict(v_r_ekf, v_l_ekf, D_T, True)\n",
    "\n",
    "        # EKF update step:\n",
    "        got_loc, pose, frame_crop = vision.localize_robot(frame)\n",
    "\n",
    "        if got_loc:\n",
    "            pose_ekf = tf.vision_to_ekf(pose)\n",
    "            ekf.update(pose_ekf, True)\n",
    "        else:\n",
    "            ekf.set_empty_measurement()\n",
    "\n",
    "        ekf_pose, ekf_cov = ekf.get_state_cov()\n",
    "        ekf_pose_img = tf.ekf_to_vision(ekf_pose)\n",
    "        \n",
    "        # Follow the path\n",
    "        closest_point = nav.find_closest_point_smoothed_path(ekf_pose_img, smooth_path)\n",
    "        \n",
    "        if closest_point is None:\n",
    "            print(\"Error: no closest point found on path.\")\n",
    "            continue\n",
    "\n",
    "        ret = nav.target_point(closest_point_on_path=closest_point, look_ahead_distance=10*px_per_cm,\n",
    "                                path=smooth_path, return_angles=True)\n",
    "        target_y_x, closest_seg_angle, target_seg_angle = ret\n",
    "            \n",
    "        # print(f\"Target point: {target_y_x}, closest seg angle: {closest_seg_angle}, target seg angle: {target_seg_angle}\")\n",
    "\n",
    "        # Calculate and set wheel speeds\n",
    "        px_per_m = px_per_cm * 100\n",
    "        target_meters = [target_x_y[0]/px_per_m, target_x_y[1]/px_per_m, target_seg_angle]\n",
    "        pose_ekf_img_meters = [ekf_pose_img[0]/px_per_m, ekf_pose_img[1]/px_per_m, ekf_pose_img[2]]\n",
    "        left_wheel_speed, right_wheel_speed = control.control(robot_pose=pose_ekf_img_meters,\n",
    "                                                                goal_pose=target_meters)\n",
    "            \n",
    "        # print(f\"Setting wheel speeds: Left: {left_wheel_speed}, Right: {right_wheel_speed}\")\n",
    "        # TODO: add local navigation\n",
    "\n",
    "        thymio.set_motors(right_wheel_speed, left_wheel_speed)\n",
    "\n",
    "    # Handle timeout counter\n",
    "    else:\n",
    "        if timeout_count > TIMEOUT_CYCLES:\n",
    "            TIMEOUT = False\n",
    "            PLAN_PATH = True\n",
    "            timeout_count = 0\n",
    "        else:\n",
    "            timeout_count += 1\n",
    "            frame_crop = vision._cut_frame_to_world(frame)\n",
    "            cv2.putText(frame_crop, f\"KIDNAPED!\", (155, 280), cv2.FONT_HERSHEY_SIMPLEX, 0.9, (0, 0, 255), 3)\n",
    "\n",
    "    # Visualize everything # TODO: clean up  \n",
    "    draw_path(frame_crop, smooth_path, (0, 255, 0))\n",
    "    draw_point(frame_crop, closest_point, (255, 0, 255))\n",
    "    draw_pose(frame_crop, ekf_pose_img, (0, 255, 255))\n",
    "    # draw_covariance(frame_crop, ekf_cov, ekf_pose_img, (0, 255, 255)) j # TODO:\n",
    "        \n",
    "    target_x_y = (target_y_x[1], target_y_x[0])\n",
    "    draw_point(frame_crop, target_x_y, (0, 165, 255))\n",
    "    # draw arrow with target point and heading\n",
    "    x, y = target_x_y\n",
    "    x = int(x)\n",
    "    y = int(y)\n",
    "    arrow_length = 20\n",
    "    x2 = int(x + arrow_length * np.cos(target_seg_angle))\n",
    "    y2 = int(y + arrow_length * np.sin(target_seg_angle))\n",
    "    cv2.arrowedLine(frame_crop, (x, y), (x2, y2), (0, 165, 255), thickness=2)\n",
    "\n",
    "    distance_to_goal = np.hypot(ekf_pose_img[0] - goal_pos[0], ekf_pose_img[1] - goal_pos[1]) / px_per_cm\n",
    "    cv2.putText(frame_crop, f\"Distance to goal: {distance_to_goal:.2f} cm\", (40,30), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255,255,255), 2)\n",
    "    # superpose the grid on the frame_crop\n",
    "    grid_color = cv2.cvtColor(grid, cv2.COLOR_GRAY2BGR)\n",
    "    grid_color = cv2.resize(grid_color, (frame_crop.shape[1], frame_crop.shape[0]))\n",
    "    grid_color = cv2.bitwise_not(grid_color)\n",
    "    alpha = 0.5\n",
    "    cv2.addWeighted(grid_color, alpha, frame_crop, 1 - alpha, 0, frame_crop)\n",
    "    \n",
    "    # Stop the loop if goal is reached\n",
    "    if cv2.waitKey(1) & 0xFF == ord('q') or distance_to_goal < 3:\n",
    "        if distance_to_goal < 3:\n",
    "            cv2.putText(frame_crop, f\"GOAL REACHED!\", (115, 280), cv2.FONT_HERSHEY_SIMPLEX, 0.9, (0, 255, 0), 3)\n",
    "            print(\"Reached goal!\")\n",
    "            cv2.imshow(\"output\", frame_crop)\n",
    "        break\n",
    "\n",
    "    cv2.imshow(\"output\", frame_crop)\n",
    "\n",
    "    # Wait until next iteration\n",
    "    loop_delta_t = time.time() - loop_start\n",
    "    # print(f\"Loop delta t: {loop_delta_t}\")\n",
    "    # thymio.wait(D_T)\n",
